# DeepDive environment configuration template
#
# DeepDive runs fully locally with no backend service (architecture.md §7).
# There is no server, and therefore no port to configure.

# --- Model provider (BYO key, architecture.md §9b) -------------------------
# Preferred: store the key in your OS credential store. key_store.ts reads that
# first and falls back to these variables only when the credential store is empty.
# Each provider reads only its own key — there is no cross-provider fallback,
# so one vendor's credential is never sent to another vendor's endpoint.
#
# Selected provider: anthropic (default), deepseek, openrouter, or custom
MODEL_PROVIDER=deepseek

# Model ids must be pinned. A moving alias (anything containing "latest") is
# rejected at construction, because it would change the grader between a
# student's submissions (architecture.md D-5).

# DeepSeek
DEEPSEEK_API_KEY=deeepseek-api
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter — one OpenAI-compatible API in front of many vendors.
# Model slugs are vendor-qualified, e.g. anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Local storage ---------------------------------------------------------
# Single-file SQLite database (architecture.md §9c).
DATABASE_URL=file:./data/deepdive.db

# --- Sandbox ---------------------------------------------------------------
# Wall-clock ceiling for a single sandboxed execution.
DEEPDIVE_SANDBOX_TIMEOUT_MS=60000

# NOTE: there is deliberately no round or retry cap. Students get unlimited
# revision rounds (architecture.md §7) — do not reintroduce one here.
